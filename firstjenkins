pipeline {
  agent {
    docker { image 'node:16' }
  }
  stages {
    stage('Back-end') {
     agent {
        docker { image 'maven:3.8.6-openjdk-11' }
      }
      steps {
        sh 'mvn --version'
      }
    }
   stage('Front-end') {
     agent {
        docker { image 'node":latest' }
       }
      steps {
        sh 'node --version'
      }
    }
  }
}
